# Copy to .env.local (gitignored) or set these in Vercel > Settings >
# Environment Variables. Never commit real values.
#
# Pull the real values down from Vercel with:  vercel env pull .env.local
#
# Every one of these is optional in the sense that the app builds and runs
# with none of them set -- pasting a list, searching iTunes, playing a full
# ranking, seeing results, and every export all work with zero
# configuration. Each var below unlocks exactly one extra feature; missing
# ones degrade to an honest message in the UI, never a broken button or a
# silent failure.

# --- Saved rankings (sign-in + /my-rankings) ---------------------------

# Auth.js session signing secret. Generate one with:  npx auth secret
# Without this (and the two Google vars below), sign-in is hidden entirely
# and /my-rankings explains that saved rankings aren't configured here.
AUTH_SECRET=

# Google OAuth client, from Google Cloud Console > Credentials.
# The client ID is public (it is sent to the browser during the OAuth flow);
# the secret is not, and must never be committed or pasted into a chat.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Neon Postgres connection string. Injected automatically by the Vercel
# Neon integration; pull it locally with `vercel env pull .env.local`. Saved
# history needs both this AND the Google vars above -- an account with
# nowhere to save it isn't useful, so both halves are required together.
DATABASE_URL=

# --- Spotify playlist export (optional) ----------------------------------

# From the app you register at developer.spotify.com. Export is the ONLY
# thing SongRank uses Spotify for -- songs, previews and artwork all come
# from iTunes (see lib/itunes.ts on why: Spotify stopped serving preview_url
# to apps created after Nov 2024, so it cannot supply a 30-second clip).
#
# Unset is a supported state: the export button simply isn't offered, the
# same way sign-in hides itself without the Google vars.
#
# The client ID is public -- it goes in the OAuth redirect the browser
# follows. The SECRET is not, and is only ever read server-side when
# exchanging or refreshing a token. Neither may be renamed to NEXT_PUBLIC_*:
# that prefix inlines a value into the client bundle, which for the secret
# would publish it to every visitor.
#
# The redirect URI registered with Spotify must match exactly, including the
# scheme and any trailing slash:
#   https://song-rankings.vercel.app/api/spotify/callback
#   http://localhost:3003/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Testing only --------------------------------------------------------

# Set to "1" to make song search/resolve return a deterministic fixture set
# (see lib/fixtures.ts) with locally-synthesized preview tones instead of
# calling the real iTunes Search API. Exists because some sandboxes block
# outbound requests to itunes.apple.com, so this is the only way to exercise
# the full search -> play -> vote loop offline. Leave unset in production --
# real searches should return real songs.
SONGRANK_PREVIEW_FIXTURES=
