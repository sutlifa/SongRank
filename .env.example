# Copy to .env.local (gitignored) or set these in Vercel > Settings >
# Environment Variables. Never commit real values.
#
# Pull the real values down from Vercel with:  vercel env pull .env.local
#
# Every one of these is optional in the sense that the app builds and runs
# with none of them set -- pasting a list, searching iTunes, playing a full
# tournament, seeing results, and every export except the Spotify one all
# work with zero configuration. Each var below unlocks exactly one extra
# feature; missing ones degrade to an honest message in the UI, never a
# broken button or a silent failure.

# --- Saved history (sign-in + /history) --------------------------------

# Auth.js session signing secret. Generate one with:  npx auth secret
# Without this (and the two Google vars below), sign-in is hidden entirely
# and /history explains that saved history isn't configured here.
AUTH_SECRET=

# Google OAuth client, from Google Cloud Console > Credentials.
# The client ID is public (it is sent to the browser during the OAuth flow);
# the secret is not, and must never be committed or pasted into a chat.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Neon Postgres connection string. Injected automatically by the Vercel
# Neon integration; pull it locally with `vercel env pull .env.local`. Saved
# history needs both this AND the Google vars above -- an account with
# nowhere to save it isn't useful, so both halves are required together.
DATABASE_URL=

# --- Spotify (playlist import + ranked-playlist export) ----------------

# From the Spotify Developer Dashboard (developer.spotify.com/dashboard).
# The client-credentials flow (playlist import) only needs these two, no
# user sign-in required. Without them, /new's "Import a Spotify playlist"
# tab explains that Spotify import isn't configured and points at paste/
# search instead; paste and search both work with these unset.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# The exact redirect URI registered in the Spotify dashboard for this
# deployment: https://song-rankings.vercel.app/api/spotify/callback for
# production, or http://localhost:3003/api/spotify/callback for local dev.
# It must match what is registered in the Spotify dashboard character for
# character -- Spotify rejects the callback on any mismatch, trailing slash
# included, and the resulting error names no cause.
# Only needed for the *export* half (creating a ranked playlist as a signed-
# in Spotify user) -- import doesn't redirect anywhere. Without this, the
# results page's "Export to Spotify" button is visibly disabled with a
# one-line reason; every other export (copy, CSV, JSON) still works.
SPOTIFY_REDIRECT_URI=

# --- Testing only --------------------------------------------------------

# Set to "1" to make song search/resolve return a deterministic fixture set
# (see lib/fixtures.ts) with locally-synthesized preview tones instead of
# calling the real iTunes Search API. Exists because some sandboxes block
# outbound requests to itunes.apple.com, so this is the only way to exercise
# the full search -> play -> vote loop offline. Leave unset in production --
# real searches should return real songs.
SONGRANK_PREVIEW_FIXTURES=
